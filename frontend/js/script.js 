        document.getElementById(
            "criticalIncidents"
        ).textContent =
            data.critical_incidents ?? 0;


        document.getElementById(
            "highIncidents"
        ).textContent =
            data.high_incidents ?? 0;


        document.getElementById(
            "resolvedIncidents"
        ).textContent =
