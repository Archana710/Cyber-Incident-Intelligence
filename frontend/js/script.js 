// ==========================================
// INCIDENT CHART
// ==========================================

let incidentChart = null;


function createIncidentChart(data) {

    const canvas =
        document.getElementById(
            "incidentChart"
        );


    if (!canvas)
        return;


    if (incidentChart) {

        incidentChart.destroy();

    }


    const labels =
        Object.keys(data);


    const values =
        Object.values(data);


    incidentChart =
        new Chart(
            canvas,
            {

                type: "line",

                data: {

                    labels: labels,

                    datasets: [

                        {

                            label:
                                "Incidents",

                            data:
                                values,

                            borderWidth: 3,

                            tension: 0.4,

                            fill: false

                        }

                    ]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    plugins: {

                        legend: {
                            display: false
                        }

                    },

                    scales: {

                        y: {

                            beginAtZero: true

                        }

                    }

                }

            }
        );

}


// ==========================================
// RISK CHART
// ==========================================

let riskChart = null;


function createRiskChart(data) {

    const canvas =
        document.getElementById(
            "riskChart"
        );


    if (!canvas)
        return;


    if (riskChart) {

        riskChart.destroy();

    }


    const labels = [
        "Critical",
        "High",
        "Medium",
        "Low"
    ];


    const values = [

        data.Critical || 0,
        data.High || 0,
        data.Medium || 0,
        data.Low || 0

    ];


    riskChart =
        new Chart(
            canvas,
            {

                type: "doughnut",

                data: {

                    labels: labels,

                    datasets: [

                        {

                            data: values,

                            borderWidth: 0

                        }

                    ]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    plugins: {

                        legend: {
                            position: "bottom"
                        }

                    }

                }

            }
        );

}


// ==========================================
// INCIDENTS
// ==========================================

async function loadIncidents() {

    try {

        const response =
            await fetch(
                `${API_BASE_URL}/incidents`
            );


        if (!response.ok)
            throw new Error();


        const incidents =
            await response.json();


        renderIncidents(
            incidents
        );

    }

    catch {

        console.log(
            "Incident data waiting for backend."
        );

    }

}


function renderIncidents(incidents) {

    const body =
        document.getElementById(
            "recentIncidentsBody"
        );


    if (!body)
        return;


    if (!incidents.length) {

        body.innerHTML = `

            <tr>

                <td
                    colspan="6"
                    class="empty-table">

                    No incidents detected.

                </td>

            </tr>

        `;

        return;

    }


    body.innerHTML =
        incidents.map(
            incident => `

        <tr>

            <td>

                <strong>
                    ${incident.incident_id}
                </strong>

                <small>
                    ${incident.incident_name}
                </small>

            </td>

            <td>
                ${incident.type || "Unknown"}
            </td>

            <td>

                <span
                    class="risk ${getRiskClass(
                        incident.severity
                    )}">

                    ${incident.severity}
                    ·
                    ${incident.risk_score}

                </span>

            </td>

            <td>
                ${incident.status}
            </td>

            <td>
                ${incident.detected_at || "-"}
            </td>

            <td>

                <button
                    class="view-button"
                    onclick="viewIncident(
                        '${incident.incident_id}'
                    )">

                    View

                </button>

            </td>

        </tr>

    `
        ).join("");

}


function getRiskClass(severity) {

    if (!severity)
        return "medium-risk";


    const value =
        severity.toLowerCase();


    if (value === "critical")
        return "critical-risk";

    if (value === "high")
        return "high-risk";

    if (value === "medium")
        return "medium-risk";

    return "low-risk";

}


// ==========================================
// VIEW INCIDENT
// ==========================================

async function viewIncident(id) {

    openSection(
        "incidents"
    );


    try {

        const response =
            await fetch(
                `${API_BASE_URL}/incidents/${id}`
            );


        if (!response.ok)
            throw new Error();


        const incident =
            await response.json();


        renderIncidentDetails(
            incident
        );

    }

    catch {

        console.log(
            "Incident details unavailable."
        );

    }

}


function renderIncidentDetails(
    incident
) {

    const container =
        document.getElementById(
            "incidentDetails"
        );


    if (!container)
        return;


    container.innerHTML = `

        <div class="incident-overview">

            <div class="incident-main">

                <span>
                    ${incident.incident_id}
                </span>

                <h2>
                    ${incident.incident_name}
                </h2>

                <p>
                    ${incident.description || ""}
                </p>

                <br>

                <h3>
                    Attack Story
                </h3>

                <br>

                <div class="timeline">

                    ${(incident.events || [])
                        .map(
                            (event, index) => `

                        <div class="timeline-item">

                            <span
                                class="timeline-number">

                                ${index + 1}

                            </span>

                            <div>

                                <strong>
                                    ${event.event_type}
                                </strong>

                                <p>
                                    ${event.description || ""}
                                </p>

                            </div>

                        </div>

                    `
                        )
                        .join("")}

                </div>

            </div>


            <div class="intelligence-panel">

                <h3>
                    🧠 AI Intelligence
                </h3>

                <div class="analysis-box">

                    <strong>
                        ${incident.analysis || "Analysis pending"}
                    </strong>

                    <p>
                        Confidence:
                        ${incident.confidence_score || 0}%
                    </p>

                </div>


                <h3>
                    🛡️ Recommended Response
                </h3>

                <ul class="response-list">

                    ${(incident.recommended_actions || [])
                        .map(
                            action => `

                        <li>
                            ${action}
                        </li>

                    `
                        )
                        .join("")}

                </ul>

            </div>

        </div>

    `;

}


// ==========================================
// SECURITY EVENTS
// ==========================================

async function loadEvents() {

    try {

        const response =
            await fetch(
                `${API_BASE_URL}/events`
            );


        if (!response.ok)
            throw new Error();


        const events =
            await response.json();


        renderEvents(events);

    }

    catch {

        console.log(
            "Security events waiting for backend."
        );

    }

}


function renderEvents(events) {

    const body =
        document.getElementById(
            "eventsBody"
        );


    if (!body)
        return;


    if (!events.length) {

        body.innerHTML = `

            <tr>

                <td
                    colspan="6"
                    class="empty-table">

                    No security events available.

                </td>

            </tr>

        `;

        return;

    }


    body.innerHTML =
        events.map(
            event => `

        <tr>

            <td>
                ${event.event_id}
            </td>

            <td>
                ${event.event_type}
            </td>

            <td>
                ${event.source_ip || "-"}
            </td>

            <td>
                ${event.user_id || "-"}
            </td>

            <td>

                <span
                    class="risk ${getRiskClass(
                        event.severity
                    )}">

                    ${event.severity}

                </span>

            </td>

            <td>
                ${event.event_time || "-"}
            </td>

        </tr>

    `
        ).join("");

}


// ==========================================
// ADD SECURITY EVENT
// ==========================================

function openEventForm() {

    const form =
        document.getElementById(
            "eventForm"
        );


    form.style.display =
        form.style.display === "none"
            ? "block"
            : "none";

}


async function submitEvent() {

    const eventData = {

        event_type:
            document.getElementById(
                "eventType"
            ).value,

        source_ip:
            document.getElementById(
                "sourceIP"
            ).value,

        user_id:
            document.getElementById(
                "eventUser"
            ).value,

        device_id:
            document.getElementById(
                "deviceID"
            ).value,

        description:
            document.getElementById(
                "eventDescription"
            ).value

    };


    try {

        const response =
            await fetch(
                `${API_BASE_URL}/events`,
                {

                    method: "POST",

                    headers: {

                        "Content-Type":
                            "application/json"

                    },

                    body:
                        JSON.stringify(
                            eventData
                        )

                }
            );


        if (!response.ok)
            throw new Error();


        alert(
            "Security event submitted successfully."
        );


        loadEvents();
        loadDashboard();

    }

    catch {

        alert(
            "Backend is not connected."
        );

    }

}


