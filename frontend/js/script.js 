const API_BASE_URL = "http://127.0.0.1:8000";


// ==========================================
// LOGIN
// ==========================================

const loginForm =
    document.getElementById("loginForm");


if (loginForm) {

    loginForm.addEventListener(
        "submit",
        async function(event) {

            event.preventDefault();

            const email =
                document.getElementById("email").value;

            const password =
                document.getElementById("password").value;

            const message =
                document.getElementById("loginMessage");


            message.textContent =
                "Connecting to backend...";

            message.style.color =
                "#2563eb";


            try {

                const response =
                    await fetch(
                        `${API_BASE_URL}/auth/login`,
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body: JSON.stringify({
                                email: email,
                                password: password
                            })
                        }
                    );


                if (!response.ok) {
                    throw new Error(
                        "Invalid login"
                    );
                }


                const data =
                    await response.json();


                localStorage.setItem(
                    "access_token",
                    data.access_token
                );


                window.location.href =
                    "index.html";

            }

            catch (error) {

                message.textContent =
                    "Backend is not connected or login failed.";

                message.style.color =
                    "#dc2626";

            }

        }
    );

}


// ==========================================
// LOGOUT
