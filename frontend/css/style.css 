* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg: #f5f7fb;
    --sidebar: #101827;
    --sidebar-light: #1a2638;
    --primary: #2563eb;
    --text: #172033;
    --muted: #718096;
    --border: #e5e9f0;
    --white: #ffffff;

    --critical: #dc2626;
    --high: #ea580c;
    --medium: #d97706;
    --low: #16a34a;
}

body {
    font-family: "Segoe UI", Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
}


/* =========================================
   LOGIN
========================================= */

.login-page {
    min-height: 100vh;

    display: flex;
    align-items: center;
    justify-content: center;

    background:
        linear-gradient(
            135deg,
            #0f172a,
            #172554
        );
}

.login-container {
    width: 100%;
    max-width: 420px;
    padding: 20px;
}

.login-box {
    background: white;

    padding: 40px;

    border-radius: 16px;

    box-shadow:
        0 20px 50px rgba(0,0,0,0.25);

    text-align: center;
}

.login-logo {
    width: 65px;
    height: 65px;

    margin: auto;
    margin-bottom: 15px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 15px;

    background: #dbeafe;

    font-size: 32px;
}

.login-box h1 {
    font-size: 27px;
}

.login-subtitle {
    color: var(--muted);
    margin-top: 6px;
    margin-bottom: 30px;
}

.login-box form {
    text-align: left;
}

.login-box label {
    display: block;

    margin-top: 15px;
    margin-bottom: 7px;

    font-size: 13px;
    font-weight: 600;
}

.login-box input {
    width: 100%;

    padding: 13px;

    border: 1px solid var(--border);

    border-radius: 8px;

    outline: none;

    font-size: 14px;
}

.login-box input:focus {
    border-color: var(--primary);
}

.login-button {
    width: 100%;

    padding: 13px;

    margin-top: 25px;

    border: none;
    border-radius: 8px;

    background: var(--primary);
    color: white;

    font-size: 15px;
    font-weight: 600;

    cursor: pointer;
}

.login-button:hover {
    background: #1d4ed8;
}

#loginMessage {
    text-align: center;
    margin-top: 15px;
    font-size: 12px;
}

.login-footer {
    margin-top: 25px;

    color: var(--muted);

    font-size: 10px;
}


/* =========================================
   SIDEBAR
========================================= */

.sidebar {
    position: fixed;

    left: 0;
    top: 0;

    width: 255px;
    height: 100vh;

    background: var(--sidebar);

    color: white;

    padding: 25px 16px;

    display: flex;
    flex-direction: column;

    z-index: 10;
}

.logo {
    display: flex;

    align-items: center;

    gap: 12px;

    padding: 5px 10px 30px;
}

.logo-icon {
    width: 42px;
    height: 42px;

    display: flex;

    align-items: center;
    justify-content: center;

    background: #1e3a8a;

    border-radius: 10px;

    font-size: 22px;
}

.logo h2 {
    font-size: 18px;
}

.logo span {
    font-size: 10px;

    color: #94a3b8;
}

nav {
    display: flex;

    flex-direction: column;

    gap: 7px;
}

.nav-link {
    color: #aeb9ca;

    text-decoration: none;

    padding: 13px 14px;

    border-radius: 8px;

    display: flex;

    align-items: center;

    gap: 12px;

    font-size: 14px;

    transition: 0.2s;
}

.nav-link:hover,
.nav-link.active {
    background: var(--sidebar-light);
    color: white;
}

.nav-link.active {
    border-left: 3px solid #60a5fa;
}

.badge {
    margin-left: auto;

    background: #dc2626;

    color: white;

    font-size: 10px;

    padding: 3px 7px;

    border-radius: 20px;
}

.sidebar-bottom {
    margin-top: auto;

    display: flex;

    flex-direction: column;

    gap: 8px;
}

.sidebar-bottom a {
    color: #94a3b8;

    text-decoration: none;

    padding: 8px 12px;
}

.system-status {
    margin-top: 10px;

    padding: 12px;

    border-radius: 8px;

    background: #172235;

    font-size: 11px;

    color: #aeb9ca;
}

.status-dot {
    display: inline-block;

    width: 8px;
    height: 8px;

    background: #f59e0b;

    border-radius: 50%;

    margin-right: 7px;
}

.status-dot.online {
    background: #22c55e;
}

.status-dot.offline {
    background: #ef4444;
}

.logout-button {
    border: none;

    background: transparent;

    color: #94a3b8;

    text-align: left;

    padding: 9px 12px;

    cursor: pointer;

    font-size: 13px;
}

.logout-button:hover {
    color: white;
}


/* =========================================
   MAIN
========================================= */

.main-content {
    margin-left: 255px;

    min-height: 100vh;

    padding: 30px;
}


/* =========================================
   TOPBAR
========================================= */

.topbar {
    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 30px;
}

.topbar h1 {
    font-size: 25px;
}

.topbar p {
    margin-top: 5px;

    color: var(--muted);

    font-size: 13px;
}

.topbar-right {
    display: flex;

    align-items: center;

    gap: 20px;
}

.icon-button {
    position: relative;

    border: none;

    background: white;

    width: 42px;
    height: 42px;

    border-radius: 9px;

    cursor: pointer;

    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.notification-dot {
    position: absolute;

    top: 7px;
    right: 7px;

    width: 7px;
    height: 7px;

    background: red;

    border-radius: 50%;
}

.profile {
    display: flex;

    align-items: center;

    gap: 10px;
}

.profile strong {
    display: block;

    font-size: 13px;
}

.profile small {
    color: var(--muted);
}

.avatar {
    width: 40px;
    height: 40px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #2563eb;

    color: white;

    font-weight: bold;
}


/* =========================================
   STATISTICS
========================================= */

.stats-grid {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 18px;

    margin-bottom: 22px;
}

.stat-card {
    background: white;

    border: 1px solid var(--border);

    border-radius: 12px;

    padding: 20px;

    display: flex;

    align-items: center;

    gap: 15px;
}

.stat-icon {
    width: 48px;
    height: 48px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 10px;

    font-size: 20px;
}

.stat-icon.blue {
    background: #dbeafe;
}

.stat-icon.red {
    background: #fee2e2;
}

.stat-icon.orange {
    background: #ffedd5;
}

.stat-icon.green {
    background: #dcfce7;
}

.stat-card span {
    color: var(--muted);

    font-size: 12px;
}

.stat-card h2 {
    margin: 5px 0;

    font-size: 25px;
}

.stat-card small {
    color: var(--muted);

    font-size: 10px;
}


/* =========================================
   CARDS
========================================= */

.card {
    background: white;

    border: 1px solid var(--border);

    border-radius: 12px;

    padding: 20px;

    margin-bottom: 22px;
}

.card-header {
    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 20px;
}

.card-header h3 {
    font-size: 16px;
}

.card-header p {
    color: var(--muted);

    font-size: 11px;

    margin-top: 4px;
}


/* =========================================
   CHARTS
========================================= */

.charts-grid {
    display: grid;

    grid-template-columns: 2fr 1fr;

    gap: 20px;

    margin-bottom: 22px;
}

.chart-card {
    min-height: 340px;
}

.chart-wrapper {
    height: 250px;
}

.chart-wrapper canvas {
    width: 100% !important;
    height: 100% !important;
}

.donut-container {
    height: 250px;

    display: flex;

    justify-content: center;
}


/* =========================================
   TABLE
========================================= */

.table-container {
    overflow-x: auto;
}

table {
    width: 100%;

    border-collapse: collapse;
}

th {
    text-align: left;

    color: #718096;

    font-size: 11px;

    padding: 13px;

    background: #f8fafc;
}

td {
    padding: 15px 13px;

    border-bottom: 1px solid #edf0f4;

    font-size: 12px;
}

td small {
    display: block;

    color: var(--muted);

    margin-top: 4px;
}

.empty-table {
    text-align: center;

    color: var(--muted);

    padding: 35px;
}


/* =========================================
   RISK
========================================= */

.risk {
    padding: 5px 8px;

    border-radius: 20px;

    font-size: 10px;

    font-weight: 600;
}

.critical-risk {
    background: #fee2e2;
    color: #b91c1c;
}

.high-risk {
    background: #ffedd5;
    color: #c2410c;
}

.medium-risk {
    background: #fef3c7;
    color: #b45309;
}

.low-risk {
    background: #dcfce7;
    color: #15803d;
}


/* =========================================
   BUTTONS
========================================= */

.primary-button {
    border: none;

    background: #2563eb;

    color: white;

    padding: 11px 17px;

    border-radius: 7px;

    cursor: pointer;

    font-weight: 600;
}

.primary-button:hover {
    background: #1d4ed8;
}

.view-button {
    border: none;

    background: transparent;

    color: var(--primary);

    cursor: pointer;

    font-weight: 600;
}


/* =========================================
   SECTIONS
========================================= */

.page-section {
    display: none;
}

.active-section {
    display: block;
}

.section-title {
    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 22px;
}

.section-title h2 {
    font-size: 21px;
}

.section-title p {
    color: var(--muted);

    font-size: 12px;

    margin-top: 5px;
}


/* =========================================
   INCIDENT
========================================= */

.incident-overview {
    display: grid;

    grid-template-columns: 2fr 1fr;

    gap: 20px;
}

.incident-main,
.intelligence-panel {
    background: white;

    border: 1px solid var(--border);

    border-radius: 12px;

    padding: 25px;
}

.risk-score {
    padding: 20px;

    background: #f8fafc;

    border-radius: 10px;

    margin-bottom: 25px;
}

.risk-score strong {
    display: block;

    font-size: 30px;

    margin-top: 5px;
}

.progress {
    height: 8px;

    background: #e5e7eb;

    border-radius: 10px;

    margin-top: 10px;

    overflow: hidden;
}

.progress div {
    height: 100%;

    background: #dc2626;

    border-radius: 10px;
}

.timeline {
    position: relative;

    padding-left: 25px;
}

.timeline::before {
    content: "";

    position: absolute;

    left: 9px;

    top: 10px;

    bottom: 10px;

    width: 2px;

    background: #dbeafe;
}

.timeline-item {
    position: relative;

    display: flex;

    gap: 15px;

    margin-bottom: 22px;
}

.timeline-number {
    position: absolute;

    left: -25px;

    width: 20px;
    height: 20px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #2563eb;

    color: white;

    font-size: 9px;
}

.timeline-item strong {
    font-size: 13px;
}

.timeline-item p {
    color: var(--muted);

    font-size: 11px;

    margin-top: 4px;
}

.analysis-box {
    background: #eff6ff;

    border: 1px solid #bfdbfe;

    border-radius: 9px;

    padding: 15px;

    margin-bottom: 25px;
}

.response-list {
    list-style: none;

    margin-bottom: 25px;
}

.response-list li {
    font-size: 12px;

    padding: 10px;

    background: #f8fafc;

    margin-bottom: 7px;

    border-radius: 6px;
}


/* =========================================
   EVENTS
========================================= */

.event-filters {
    display: flex;

    gap: 12px;

    margin-bottom: 20px;
}

.event-filters input,
.event-filters select,
.event-form input,
.event-form textarea {
    padding: 11px;

    border: 1px solid var(--border);

    border-radius: 7px;

    font-size: 12px;

    outline: none;
}

.event-filters input {
    flex: 1;
}

.event-form {
    margin-bottom: 20px;
}

.form-grid {
    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 12px;

    margin: 15px 0;
}

.event-form textarea {
    width: 100%;

    min-height: 90px;

    margin-bottom: 15px;

    resize: vertical;
}


/* =========================================
   THREATS
========================================= */

.threat-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 18px;

    margin-bottom: 20px;
}

.threat-card {
    background: white;

    border: 1px solid var(--border);

    border-radius: 12px;

    padding: 20px;
}

.threat-icon {
    font-size: 25px;
}

.threat-card h3 {
    font-size: 14px;

    margin: 10px 0;
}

.threat-card strong {
    font-size: 28px;
}

.threat-card p {
    color: var(--muted);

    font-size: 11px;
}


/* =========================================
   EMPTY STATE
========================================= */

.empty-state {
    min-height: 350px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;
}

.empty-icon {
    font-size: 45px;

    margin-bottom: 15px;
}

.empty-state h3 {
    margin-bottom: 8px;
}

.empty-state p {
    max-width: 450px;

    color: var(--muted);

    font-size: 12px;

    line-height: 1.6;
}


/* =========================================
   RESPONSIVE
========================================= */

@media (max-width: 1100px) {

    .stats-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .charts-grid,
    .incident-overview {
        grid-template-columns: 1fr;
    }

}

@media (max-width: 750px) {

    .sidebar {
        width: 70px;
        padding: 15px 8px;
    }

    .logo div:not(.logo-icon),
    .nav-link span:not(.badge),
    .sidebar-bottom a,
    .system-status span:last-child {
        display: none;
    }

    .main-content {
        margin-left: 70px;

        padding: 18px;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .threat-grid {
        grid-template-columns: 1fr;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .topbar {
        align-items: flex-start;
    }

    .profile div:last-child {
        display: none;
    }

}